{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/bridge/(.*)",
      "destination": "https://gradosphera-tonconnect-bridge.dao-f7d.workers.dev/bridge/$1"
    },
    {
      "source": "/toncenter/(.*)",
      "destination": "/api/toncenter/$1"
    },
    {
      "source": "/toncenter-testnet/(.*)",
      "destination": "https://toncenter-testnet.mytonwallet.org/$1"
    },
    {
      "source": "/tonapiio/(.*)",
      "destination": "/api/tonapiio/$1"
    },
    {
      "source": "/tonapiio-testnet/(.*)",
      "destination": "https://tonapiio-proxy.dao-f7d.workers.dev/$1"
    },
    {
      "source": "/mtw-api/(.*)",
      "destination": "/api/mtw/$1"
    },
    {
      "source": "/tronapi/(.*)",
      "destination": "https://tronapi.mytonwallet.org/$1"
    },
    {
      "source": "/tronapi-testnet/(.*)",
      "destination": "https://api.shasta.trongrid.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
